MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/daily-expense-tracker?retryWrites=true&w=majority
PORT=5000

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# SMTP — Your Domain's Mail Server
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-email-password
SMTP_FROM="HisabKitab <noreply@yourdomain.com>"

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client URL (for email links)
CLIENT_URL=http://localhost:3000

# Environment
NODE_ENV=development